# ---------- Public (exposed to the browser) ----------
# Canonical origin of the public site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-side API base path (same-origin, rewritten to API_INTERNAL_URL)
NEXT_PUBLIC_API_BASE_PATH=/api/v1
# Public base URL of the MinIO bucket that serves media (used for next/image remotePatterns)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/barathon
# Default locale for <html lang>
NEXT_PUBLIC_DEFAULT_LOCALE=en
# false on staging forces noindex + Disallow: / regardless of CMS settings
NEXT_PUBLIC_ENABLE_INDEXING=true
# Optional: link the footer credit to a URL (credit text itself is fixed in code)
NEXT_PUBLIC_DEVELOPER_URL=

# ---------- Server only ----------
# Internal URL of the NestJS API (Docker network in production)
API_INTERNAL_URL=http://localhost:3001
# HMAC secret shared with the API for POST /api/revalidate (min 32 chars)
REVALIDATE_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Secret used to verify draft/preview tokens issued by the API
PREVIEW_SECRET=change-me-preview-secret-32-plus-characters

# ---------- Development only ----------
# Serve the built-in mock API (src/lib/mocks) instead of the real API. Ignored in production builds.
NEXT_PUBLIC_USE_MOCKS=0
