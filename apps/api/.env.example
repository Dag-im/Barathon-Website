# Copy to .env for local development. Never commit a real .env file.
# Placeholder values below are refused when NODE_ENV=production.

# ---------- General ----------
NODE_ENV=development            # development | production | test
PORT=4000
LOG_LEVEL=info                  # trace|debug|info|warn|error|silent
TRUST_PROXY=1                   # number of reverse-proxy hops
RATE_LIMITS_ENABLED=true

# ---------- URLs / CORS ----------
PUBLIC_SITE_URL=http://localhost:3000        # canonical site origin (canonical URLs, sitemap)
ADMIN_URL=http://localhost:3000              # origin that hosts /admin
ALLOWED_ORIGINS=http://localhost:3000        # comma list, exact origins (CORS and CSRF origin check)
API_PUBLIC_URL=http://localhost:4000/api/v1  # API base as seen by browsers
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media
REDIRECT_ALLOWED_HOSTS=localhost             # hosts allowed for absolute redirect targets
INTERNAL_API_KEY=change-me-32-chars-minimum-value

# ---------- Database ----------
DATABASE_URL=postgresql://barathon:change-me@localhost:5432/barathon?schema=public
DATABASE_POOL_MAX=10

# ---------- MinIO / S3 ----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=barathon-api
MINIO_SECRET_KEY=change-me
MINIO_REGION=us-east-1
MINIO_BUCKET_PUBLIC=public-media
MINIO_BUCKET_PRIVATE=private-docs
MAX_IMAGE_UPLOAD_MB=12
MAX_VIDEO_UPLOAD_MB=200
MAX_DOCUMENT_UPLOAD_MB=25
FFMPEG_PATH=                    # optional: path to ffmpeg for poster frames and durations

# ---------- Authentication ----------
JWT_ACCESS_SECRET=change-me-min-32-chars-random-value-here
ACCESS_TTL_SECONDS=900
REFRESH_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=30
COOKIE_SECURE=false             # true in production (HTTPS); enables __Host-/__Secure- cookie prefixes
ALLOW_BEARER=false
PASSWORD_PEPPER=change-me-min-32-chars-random-value-here
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
LOGIN_MAX_FAILURES=5
LOCKOUT_BASE_MINUTES=15
# Constant password the forgot-password flow resets the admin to. Keep it secret and rotate it
# by editing this value. Must be at least 12 characters and meet the password policy.
ADMIN_RESET_PASSWORD=change-me-to-a-long-passphrase
# Optional first-run admin, used by `seed` only when no user exists. Remove after first start.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- Captcha (optional) ----------
CAPTCHA_PROVIDER=NONE           # NONE | TURNSTILE | HCAPTCHA (site setting may override)
CAPTCHA_SECRET=

# ---------- Revalidation (API -> Next.js) ----------
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# ---------- Observability ----------
SWAGGER_ENABLED=true

# ---------- Seed ----------
SEED_ASSET_HOSTS=res.cloudinary.com
SEED_DOWNLOAD_TIMEOUT_MS=15000

# ---------- Retention ----------
AUDIT_RETENTION_DAYS=365
TRASH_RETENTION_DAYS=30
MESSAGE_IP_TRUNCATE_DAYS=90
