generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

enum MediaKind {
  IMAGE
  SVG
  ICON
  DOCUMENT
  VIDEO
}

enum VideoSourceType {
  UPLOAD
  YOUTUBE
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum SocialPlatform {
  FACEBOOK
  X
  LINKEDIN
  INSTAGRAM
  YOUTUBE
  TELEGRAM
  TIKTOK
  WHATSAPP
}

enum ContactChannelType {
  PHONE
  EMAIL
  WHATSAPP
  FAX
}

enum MenuLocation {
  HEADER
  FOOTER_QUICK
  FOOTER_PRODUCTS
  FOOTER_LEGAL
}

enum MenuItemType {
  PAGE
  ENTITY
  CUSTOM
  DYNAMIC_PRODUCTS
  DYNAMIC_SERVICES
  DYNAMIC_BRANDS
}

enum LinkTarget {
  SELF
  BLANK
}

enum BlockType {
  HERO_CAROUSEL
  BRANDS_MARQUEE
  IMAGE_TEXT
  STATS
  FEATURED_PRODUCTS
  VIDEOS_GRID
  SERVICES_GRID
  TESTIMONIALS
  LATEST_POSTS
  CTA_BANNER
  TIMELINE
  LEADER_MESSAGE
  MISSION_VISION
  CORE_VALUES
  SUBSIDIARIES
  TEAM
  FAQ
  RICH_TEXT
  IMAGE_GALLERY
  CONTACT_STRIP
  BRAND_GRID
}

enum CoreValueGroup {
  MISSION
  VALUE
}

enum BrandKind {
  PRINCIPAL
  PARTNER
}

enum DocumentLanguage {
  EN
  AM
}

enum RedirectType {
  MOVED_301
  FOUND_302
  TEMP_307
  PERM_308
}

enum RedirectMatch {
  EXACT
  PREFIX
}

enum EntityType {
  PAGE
  PRODUCT
  PRODUCT_CATEGORY
  BRAND
  SERVICE
  POST
  POST_CATEGORY
  SUBSIDIARY
  VIDEO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PURGE
  PUBLISH
  UNPUBLISH
  SCHEDULE
  ARCHIVE
  REORDER
  LOGIN
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  REFRESH_REUSE_DETECTED
  PASSWORD_CHANGE
  PASSWORD_RESET
  SESSION_REVOKE
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SETTINGS_UPDATE
  IMPORT
  EXPORT
  REVALIDATE
  MESSAGE_STATUS
  MESSAGE_NOTE
  MEDIA_UPLOAD
  MEDIA_DELETE
  CLI
}

enum TwitterCard {
  SUMMARY
  SUMMARY_LARGE_IMAGE
}

// ---------------------------------------------------------------- authentication

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique @db.Citext
  name               String    @db.VarChar(120)
  role               Role      @default(ADMIN)
  passwordHash       String
  pepperVersion      Int       @default(1)
  passwordChangedAt  DateTime  @default(now())
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  isActive           Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockCount          Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?   @db.VarChar(64)
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  avatarMediaId      String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions        AuthSession[]
  passwordHistory PasswordHistory[]

  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @db.Uuid
  userAgent         String?   @db.VarChar(400)
  deviceLabel       String?   @db.VarChar(120)
  ip                String?   @db.VarChar(64)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(40)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(64)
  parentId     String?   @db.Uuid
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  replacedById String?   @db.Uuid

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  hash      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

// ---------------------------------------------------------------- media

model MediaFolder {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(80)
  parentId  String?  @db.Uuid
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderTree")

  @@unique([parentId, name])
  @@map("media_folders")
}

model Media {
  id               String          @id @default(uuid(7)) @db.Uuid
  kind             MediaKind
  visibility       MediaVisibility @default(PUBLIC)
  bucket           String          @db.VarChar(40)
  objectKey        String          @unique
  originalName    String          @db.VarChar(255)
  mimeType         String          @db.VarChar(100)
  sizeBytes        BigInt
  sha256           String          @db.VarChar(64)
  width            Int?
  height           Int?
  blurhash         String?         @db.VarChar(100)
  dominantColor    String?         @db.VarChar(7)
  lqip             String?
  alt              String?         @db.VarChar(300)
  caption          String?         @db.VarChar(500)
  title            String?         @db.VarChar(200)
  focalX           Float?
  focalY           Float?
  folderId         String?         @db.Uuid
  version          Int             @default(1)
  processingStatus String          @default("READY") @db.VarChar(12)
  uploadedById     String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  variants MediaVariant[]

  @@index([kind])
  @@index([folderId])
  @@index([sha256])
  @@index([createdAt(sort: Desc)])
  @@map("media")
}

model MediaVariant {
  id        String @id @default(uuid(7)) @db.Uuid
  mediaId   String @db.Uuid
  label     String @db.VarChar(20)
  format    String @db.VarChar(8)
  width     Int
  height    Int
  sizeBytes Int
  objectKey String @unique

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, label, format])
  @@map("media_variants")
}

model MediaRef {
  id         String @id @default(uuid(7)) @db.Uuid
  mediaId    String @db.Uuid
  entityType String @db.VarChar(40)
  entityId   String @db.VarChar(64)
  field      String @db.VarChar(60)

  @@unique([mediaId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@map("media_refs")
}

// ---------------------------------------------------------------- SEO and settings

model SeoMeta {
  id              String      @id @default(uuid(7)) @db.Uuid
  entityType      EntityType
  entityId        String      @db.Uuid
  metaTitle       String?     @db.VarChar(200)
  metaDescription String?     @db.VarChar(400)
  ogTitle         String?     @db.VarChar(200)
  ogDescription   String?     @db.VarChar(400)
  ogImageId       String?     @db.Uuid
  twitterCard     TwitterCard @default(SUMMARY_LARGE_IMAGE)
  canonicalUrl    String?     @db.VarChar(500)
  noindex         Boolean     @default(false)
  nofollow        Boolean     @default(false)
  keywords        String?     @db.VarChar(300)
  jsonLd          Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([entityType, entityId])
  @@map("seo_meta")
}

model SiteSettings {
  id                     String   @id @default("singleton") @db.VarChar(20)
  siteName               String   @db.VarChar(120)
  legalName              String?  @db.VarChar(200)
  tagline                String?  @db.VarChar(200)
  logoLightMediaId       String?  @db.Uuid
  logoDarkMediaId        String?  @db.Uuid
  faviconMediaId         String?  @db.Uuid
  appleTouchIconMediaId  String?  @db.Uuid
  defaultOgImageMediaId  String?  @db.Uuid
  brandColors            Json
  headerCta              Json
  search                 Json
  footerBlurb            String?
  copyrightText          String   @db.VarChar(300)
  footerCredit           Json
  seoDefaults            Json
  analytics              Json
  maintenance            Json
  announcement           Json
  contactForm            Json
  robots                 Json
  sitemap                Json
  locales                String[] @default(["en"])
  defaultLocale          String   @default("en") @db.VarChar(5)
  version                Int      @default(1)
  updatedById            String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("site_settings")
}

model UiString {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @db.VarChar(120)
  locale      String   @default("en") @db.VarChar(5)
  value       String
  group       String   @db.VarChar(40)
  description String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
  @@map("ui_strings")
}

// ---------------------------------------------------------------- contact info, navigation, redirects

model ContactChannel {
  id                String            @id @default(uuid(7)) @db.Uuid
  type              ContactChannelType
  label             String?           @db.VarChar(60)
  value             String            @db.VarChar(160)
  displayValue      String?           @db.VarChar(160)
  isPrimary         Boolean           @default(false)
  showOnContactPage Boolean           @default(true)
  showInFooter      Boolean           @default(true)
  showInHeader      Boolean           @default(false)
  sortOrder         Int               @default(0)
  visible           Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("contact_channels")
}

model Office {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(120)
  isPrimary    Boolean  @default(false)
  addressLine1 String   @db.VarChar(200)
  addressLine2 String?  @db.VarChar(200)
  poBox        String?  @db.VarChar(60)
  city         String   @db.VarChar(100)
  region       String?  @db.VarChar(100)
  postalCode   String?  @db.VarChar(20)
  countryCode  String   @db.VarChar(2)
  countryName  String   @db.VarChar(80)
  latitude     Float?   @db.DoublePrecision
  longitude    Float?   @db.DoublePrecision
  mapEmbedUrl  String?  @db.VarChar(600)
  openingHours Json?
  subsidiaryId String?  @db.Uuid
  sortOrder    Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("offices")
}

model SocialLink {
  id                String         @id @default(uuid(7)) @db.Uuid
  platform          SocialPlatform
  url               String?        @db.VarChar(500)
  label             String?        @db.VarChar(60)
  showInFooter      Boolean        @default(true)
  showOnContactPage Boolean        @default(true)
  sortOrder         Int            @default(0)
  visible           Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("social_links")
}

model Menu {
  id        String       @id @default(uuid(7)) @db.Uuid
  location  MenuLocation @unique
  title     String       @db.VarChar(80)
  updatedAt DateTime     @updatedAt

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id         String       @id @default(uuid(7)) @db.Uuid
  menuId     String       @db.Uuid
  parentId   String?      @db.Uuid
  type       MenuItemType
  label      String       @db.VarChar(80)
  pageId     String?      @db.Uuid
  entityType EntityType?
  entityId   String?      @db.Uuid
  href       String?      @db.VarChar(500)
  target     LinkTarget   @default(SELF)
  icon       String?      @db.VarChar(40)
  config     Json?
  sortOrder  Int          @default(0)
  visible    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@index([menuId, parentId, sortOrder])
  @@map("menu_items")
}

model Redirect {
  id          String        @id @default(uuid(7)) @db.Uuid
  sourcePath  String        @db.VarChar(500)
  matchType   RedirectMatch @default(EXACT)
  targetPath  String        @db.VarChar(1000)
  type        RedirectType  @default(MOVED_301)
  auto        Boolean       @default(false)
  enabled     Boolean       @default(true)
  note        String?       @db.VarChar(200)
  hitCount    Int           @default(0)
  lastHitAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sourcePath, matchType])
  @@index([enabled])
  @@map("redirects")
}

// ---------------------------------------------------------------- pages and homepage composition

model Page {
  id              String        @id @default(uuid(7)) @db.Uuid
  key             String?       @unique @db.VarChar(40)
  slug            String        @unique @db.Citext
  title           String        @db.VarChar(200)
  isSystem        Boolean       @default(false)
  template        String        @default("DEFAULT") @db.VarChar(30)
  heroTitle       String?       @db.VarChar(200)
  heroSubtitle    String?       @db.VarChar(500)
  heroImageMediaId String?      @db.Uuid
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  showInSitemap   Boolean       @default(true)
  version         Int           @default(1)
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  blocks PageBlock[]

  @@map("pages")
}

model PageBlock {
  id           String    @id @default(uuid(7)) @db.Uuid
  pageId       String    @db.Uuid
  type         BlockType
  anchorId     String?   @db.VarChar(60)
  navLabel     String?   @db.VarChar(60)
  showInTabNav Boolean   @default(false)
  visible      Boolean   @default(true)
  sortOrder    Int
  data         Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_blocks")
}

model HeroSlide {
  id                String        @id @default(uuid(7)) @db.Uuid
  eyebrow           String?       @db.VarChar(120)
  heading           String        @db.VarChar(200)
  subheading        String?       @db.VarChar(500)
  imageMediaId      String        @db.Uuid
  mobileImageMediaId String?      @db.Uuid
  overlayOpacity    Int           @default(40) @db.SmallInt
  button1Label      String?       @db.VarChar(60)
  button1Href       String?       @db.VarChar(500)
  button2Label      String?       @db.VarChar(60)
  button2Href       String?       @db.VarChar(500)
  productId         String?       @db.Uuid
  brandId           String?       @db.Uuid
  startsAt          DateTime?
  endsAt            DateTime?
  status            ContentStatus @default(PUBLISHED)
  visible           Boolean       @default(true)
  sortOrder         Int           @default(0)
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@map("hero_slides")
}

model Stat {
  id        String   @id @default(uuid(7)) @db.Uuid
  value     Float    @db.DoublePrecision
  prefix    String?  @db.VarChar(10)
  suffix    String?  @db.VarChar(10)
  label     String   @db.VarChar(100)
  icon      String?  @db.VarChar(40)
  group     String   @default("GENERAL") @db.VarChar(40)
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stats")
}

model TimelineEntry {
  id           String    @id @default(uuid(7)) @db.Uuid
  yearLabel    String    @db.VarChar(30)
  startYear    Int?
  title        String    @db.VarChar(160)
  description  String?
  imageMediaId String?   @db.Uuid
  icon         String?   @db.VarChar(40)
  sortOrder    Int       @default(0)
  visible      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("timeline_entries")
}

model CoreValue {
  id          String         @id @default(uuid(7)) @db.Uuid
  group       CoreValueGroup
  title       String         @db.VarChar(160)
  description String?
  icon        String?        @db.VarChar(40)
  sortOrder   Int            @default(0)
  status      ContentStatus  @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@map("core_values")
}

model LeaderMessage {
  id               String        @id @default(uuid(7)) @db.Uuid
  heading          String        @default("CEO's Message") @db.VarChar(120)
  name             String?       @db.VarChar(120)
  jobTitle         String?       @db.VarChar(120)
  photoMediaId     String?       @db.Uuid
  signatureMediaId String?       @db.Uuid
  messageHtml      String
  isPrimary        Boolean       @default(false)
  status           ContentStatus @default(PUBLISHED)
  sortOrder        Int           @default(0)
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@map("leader_messages")
}

model TeamMember {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String        @db.VarChar(120)
  jobTitle     String?       @db.VarChar(120)
  bioHtml      String?
  photoMediaId String?       @db.Uuid
  linkedinUrl  String?       @db.VarChar(500)
  sortOrder    Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@map("team_members")
}

// ---------------------------------------------------------------- catalogue

model Brand {
  id               String        @id @default(uuid(7)) @db.Uuid
  name             String        @db.VarChar(120)
  slug             String        @unique @db.Citext
  kind             BrandKind     @default(PARTNER)
  shortDescription String        @db.VarChar(600)
  descriptionHtml  String        @default("")
  logoMediaId      String?       @db.Uuid
  logoDarkMediaId  String?       @db.Uuid
  heroImageMediaId String?       @db.Uuid
  countryCode      String?       @db.VarChar(2)
  countryName      String?       @db.VarChar(80)
  city             String?       @db.VarChar(80)
  websiteUrl       String?       @db.VarChar(500)
  isFeatured       Boolean       @default(false)
  showInMarquee    Boolean       @default(true)
  legacyId         String?       @unique @db.VarChar(24)
  sortOrder        Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  version          Int           @default(1)
  createdById      String?       @db.Uuid
  updatedById      String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  products Product[]
  videos   Video[]
  subsidiaryLinks SubsidiaryBrand[]

  @@index([status, sortOrder])
  @@map("brands")
}

model ProductCategory {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String        @db.VarChar(120)
  slug        String        @unique @db.Citext
  description String?
  imageMediaId String?      @db.Uuid
  parentId    String?       @db.Uuid
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

model Product {
  id               String        @id @default(uuid(7)) @db.Uuid
  title            String        @db.VarChar(160)
  slug             String        @unique @db.Citext
  shortDescription String        @db.VarChar(600)
  contentHtml      String        @default("")
  heroImageMediaId String?       @db.Uuid
  brandId          String?       @db.Uuid
  categoryId       String?       @db.Uuid
  extraCategoryIds String[]      @default([]) @db.Uuid
  countryCode      String?       @db.VarChar(2)
  countryName      String?       @db.VarChar(80)
  originCity       String?       @db.VarChar(80)
  isFeatured       Boolean       @default(false)
  inquiryEnabled   Boolean       @default(true)
  partNumber       String?       @db.VarChar(60)
  tagline          String?       @db.VarChar(200)
  legacyId         String?       @unique @db.VarChar(24)
  searchVector     Unsupported("tsvector")?
  sortOrder        Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  version          Int           @default(1)
  createdById      String?       @db.Uuid
  updatedById      String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  specs    ProductSpec[]
  documents ProductDocument[]
  relatedFrom ProductRelated[] @relation("RelatedFrom")
  relatedTo   ProductRelated[] @relation("RelatedTo")
  videos   Video[]

  @@index([status, sortOrder])
  @@index([brandId])
  @@index([categoryId])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id          String  @id @default(uuid(7)) @db.Uuid
  productId   String  @db.Uuid
  mediaId     String  @db.Uuid
  caption     String? @db.VarChar(300)
  altOverride String? @db.VarChar(300)
  sortOrder   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductSpec {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  groupName String? @db.VarChar(80)
  label     String  @db.VarChar(120)
  value     String  @db.VarChar(300)
  unit      String? @db.VarChar(30)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_specs")
}

model ProductDocument {
  id            String            @id @default(uuid(7)) @db.Uuid
  productId     String            @db.Uuid
  title         String            @db.VarChar(160)
  mediaId       String            @db.Uuid
  language      DocumentLanguage  @default(EN)
  visibility    MediaVisibility   @default(PUBLIC)
  downloadCount Int               @default(0)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_documents")
}

model ProductRelated {
  productId        String @db.Uuid
  relatedProductId String @db.Uuid
  sortOrder        Int    @default(0)

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@map("product_related")
}

model Service {
  id               String        @id @default(uuid(7)) @db.Uuid
  title            String        @db.VarChar(160)
  slug             String        @unique @db.Citext
  shortDescription String        @db.VarChar(600)
  bodyHtml         String?
  imageMediaId     String?       @db.Uuid
  iconName         String?       @db.VarChar(40)
  ctaLabel         String?       @db.VarChar(60)
  ctaHref          String?       @db.VarChar(300)
  legacyId         String?       @unique @db.VarChar(24)
  sortOrder        Int           @default(0)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  version          Int           @default(1)
  createdById      String?       @db.Uuid
  updatedById      String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  features ServiceFeature[]

  @@index([status, sortOrder])
  @@map("services")
}

model ServiceFeature {
  id          String  @id @default(uuid(7)) @db.Uuid
  serviceId   String  @db.Uuid
  title       String  @db.VarChar(200)
  description String? @db.VarChar(500)
  sortOrder   Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_features")
}

model Video {
  id               String          @id @default(uuid(7)) @db.Uuid
  title            String          @db.VarChar(200)
  description      String?         @db.VarChar(600)
  sourceType       VideoSourceType @default(YOUTUBE)
  youtubeId        String?         @db.VarChar(11)
  startSeconds     Int?
  sourceUrl        String?         @db.VarChar(500)
  mediaId          String?         @db.Uuid
  posterMediaId    String?         @db.Uuid
  mimeType         String?         @db.VarChar(100)
  sizeBytes        BigInt?
  durationSeconds  Int?
  brandId          String?         @db.Uuid
  productId        String?         @db.Uuid
  isFeatured       Boolean         @default(false)
  sortOrder        Int             @default(0)
  status           ContentStatus   @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  brand   Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, isFeatured, sortOrder])
  @@index([youtubeId])
  @@index([brandId])
  @@index([productId])
  @@map("videos")
}

model Subsidiary {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String        @db.VarChar(120)
  slug         String        @unique @db.Citext
  legalName    String?       @db.VarChar(200)
  kind         String        @default("OTHER") @db.VarChar(20)
  countryCode  String        @db.VarChar(2)
  regionNote   String?       @db.VarChar(120)
  tagline      String?       @db.VarChar(300)
  introHtml    String        @default("")
  bodyHtml     String?
  lists        Json          @default("[]")
  logoMediaId  String?       @db.Uuid
  imageMediaId String?       @db.Uuid
  websiteUrl   String?       @db.VarChar(500)
  sortOrder    Int           @default(0)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  brands SubsidiaryBrand[]

  @@map("subsidiaries")
}

model SubsidiaryBrand {
  subsidiaryId String @db.Uuid
  brandId      String @db.Uuid
  relation     String @default("EXCLUSIVE_RIGHTS") @db.VarChar(40)
  sortOrder    Int    @default(0)

  subsidiary Subsidiary @relation(fields: [subsidiaryId], references: [id], onDelete: Cascade)
  brand      Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([subsidiaryId, brandId])
  @@map("subsidiary_brands")
}

// ---------------------------------------------------------------- editorial

model Testimonial {
  id           String        @id @default(uuid(7)) @db.Uuid
  quote        String
  personName   String        @db.VarChar(120)
  personRole   String?       @db.VarChar(120)
  companyName  String?       @db.VarChar(160)
  photoMediaId String?       @db.Uuid
  rating       Int?          @db.SmallInt
  sortOrder    Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@map("testimonials")
}

model FaqGroup {
  id        String        @id @default(uuid(7)) @db.Uuid
  title     String        @db.VarChar(160)
  slug      String        @unique @db.Citext
  sortOrder Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  faqs Faq[]

  @@map("faq_groups")
}

model Faq {
  id         String        @id @default(uuid(7)) @db.Uuid
  groupId    String        @db.Uuid
  question   String        @db.VarChar(300)
  answerHtml String
  sortOrder  Int           @default(0)
  status     ContentStatus @default(PUBLISHED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  group FaqGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
  @@map("faqs")
}

model PostCategory {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(80)
  slug        String    @unique @db.Citext
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  posts Post[]

  @@map("post_categories")
}

model Post {
  id             String        @id @default(uuid(7)) @db.Uuid
  title          String        @db.VarChar(200)
  slug           String        @unique @db.Citext
  excerpt        String        @db.VarChar(500)
  bodyHtml       String
  coverMediaId   String?       @db.Uuid
  authorName     String?       @db.VarChar(120)
  categoryId     String?       @db.Uuid
  readingMinutes Int           @default(1) @db.SmallInt
  isFeatured     Boolean       @default(false)
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  version        Int           @default(1)
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  category PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTag[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("posts")
}

model Tag {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @db.VarChar(60)
  slug String @unique @db.Citext

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ---------------------------------------------------------------- contact messages

model ContactMessage {
  id                   String        @id @default(uuid(7)) @db.Uuid
  reference            String        @unique @db.VarChar(14)
  name                 String        @db.VarChar(120)
  email                String        @db.Citext
  phone                String?       @db.VarChar(40)
  message              String        @db.VarChar(5000)
  subject              String?       @db.VarChar(160)
  productId            String?       @db.Uuid
  productTitleSnapshot String?       @db.VarChar(160)
  sourcePath           String?       @db.VarChar(300)
  consentGiven         Boolean?
  locale               String        @default("en") @db.VarChar(5)
  status               MessageStatus @default(NEW)
  isStarred            Boolean       @default(false)
  spamScore            Int           @default(0) @db.SmallInt
  spamReasons          String[]      @default([])
  ip                   String?       @db.VarChar(64)
  userAgent            String?       @db.VarChar(400)
  readAt               DateTime?
  repliedAt            DateTime?
  handledById          String?       @db.Uuid
  archivedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  notes ContactMessageNote[]

  @@index([status, createdAt(sort: Desc)])
  @@index([isStarred])
  @@index([email])
  @@map("contact_messages")
}

model ContactMessageNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  authorId  String?  @db.Uuid
  authorName String? @db.VarChar(120)
  body      String   @db.VarChar(2000)
  kind      String   @default("NOTE") @db.VarChar(10)
  createdAt DateTime @default(now())

  message ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("contact_message_notes")
}

// ---------------------------------------------------------------- operations

model ContentRevision {
  id         String   @id @default(uuid(7)) @db.Uuid
  entityType String   @db.VarChar(40)
  entityId   String   @db.VarChar(64)
  versionNo  Int
  snapshot   Json
  changeNote String?  @db.VarChar(200)
  authorId   String?  @db.Uuid
  authorName String?  @db.VarChar(120)
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, versionNo])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("content_revisions")
}

model AuditLog {
  id         BigInt       @id @default(autoincrement())
  actorId    String?      @db.Uuid
  actorEmail String?      @db.VarChar(255)
  action     AuditAction
  entityType String?      @db.VarChar(40)
  entityId   String?      @db.VarChar(64)
  summary    String       @db.VarChar(300)
  diff       Json?
  ip         String?      @db.VarChar(64)
  userAgent  String?      @db.VarChar(400)
  requestId  String?      @db.VarChar(40)
  createdAt  DateTime     @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

model RevalidationLog {
  id        BigInt   @id @default(autoincrement())
  tags      String[]
  paths     String[]
  status    String   @db.VarChar(10)
  httpStatus Int?
  attempts  Int
  error     String?
  createdAt DateTime @default(now())

  @@map("revalidation_logs")
}
