{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Barathon Trading REST API (NestJS, Prisma, PostgreSQL, MinIO)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "cli": "node dist/cli.js",
    "admin:create": "node dist/cli.js admin:create",
    "admin:reset-password": "node dist/cli.js admin:reset-password",
    "admin:unlock": "node dist/cli.js admin:unlock",
    "admin:list": "node dist/cli.js admin:list",
    "seed": "node dist/cli.js seed",
    "seed:assets": "node dist/cli.js seed:assets",
    "db:migrate": "prisma migrate deploy",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.12",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "blurhash": "^2.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^12.0.2",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.3.2",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.2",
    "@types/passport-local": "^1.0.38",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "@types/zxcvbn": "^4.4.5",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "main": "dist/main.js",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
